# Copy this file to .env and fill in what you want to enable.
# Both sections are fully optional — the app works with neither filled in,
# it just stays local-only with no AI assist.

# --- Gemini free tier (task parsing, task breakdown, action-item extraction) ---
# Get a free key at https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=

# --- Firebase (cross-device sync via Firestore + push notifications) ---
# Create a free project at https://console.firebase.google.com,
# add a Web App, then paste its config values here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
